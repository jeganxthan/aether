{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aether-settings",
  "version": "0.1.0",
  "identifier": "com.aether-settings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aether Settings",
        "width": 1000,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null,
       "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Pictures/**", "$HOME/Wallpapers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
