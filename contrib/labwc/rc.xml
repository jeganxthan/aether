<!--
  Aether — labwc integration (fragment)
  =====================================
  This is NOT a standalone config. Copy the <keyboard> and <windowRules>
  blocks below into the matching sections of ~/.config/labwc/rc.xml, then
  reload labwc:

      labwc -r

  Back up first:  cp ~/.config/labwc/rc.xml{,.bak}

  Aether is driven by Unix signals because hardware global shortcuts do not
  work reliably under Wayland compositors:
    SIGUSR2       toggle the app launcher
    SIGWINCH      toggle the clipboard history
    SIGRTMIN+0    volume up        SIGRTMIN+1  volume down
    SIGRTMIN+2    toggle mute      SIGRTMIN+3  brightness up
    SIGRTMIN+4    brightness down
  SIGUSR1 is reserved by WebKitGTK — never send it to the process.
  The media keys show the island OSD only; they never take keyboard focus.
-->

<keyboard>
  <!-- Super + Space -> toggle the app launcher -->
  <keybind key="W-space">
    <action name="Execute" command="pkill -USR2 -x aether-tauri"/>
  </keybind>

  <!-- Super + C -> toggle the clipboard history -->
  <keybind key="W-c">
    <action name="Execute" command="pkill -WINCH -x aether-tauri"/>
  </keybind>

  <!-- Volume / brightness keys -> island OSD -->
  <keybind key="XF86AudioRaiseVolume">
    <action name="Execute" command="pkill -RTMIN+0 -x aether-tauri"/>
  </keybind>

  <keybind key="XF86AudioLowerVolume">
    <action name="Execute" command="pkill -RTMIN+1 -x aether-tauri"/>
  </keybind>

  <keybind key="XF86AudioMute">
    <action name="Execute" command="pkill -RTMIN+2 -x aether-tauri"/>
  </keybind>

  <keybind key="XF86MonBrightnessUp">
    <action name="Execute" command="pkill -RTMIN+3 -x aether-tauri"/>
  </keybind>

  <keybind key="XF86MonBrightnessDown">
    <action name="Execute" command="pkill -RTMIN+4 -x aether-tauri"/>
  </keybind>
</keyboard>

<!--
  Keep the transparent widget window flush to the top centre of the output.
  Without this rule the island gets decorations and is not positioned.

  x centres the 560px-wide window: x = (output_width - 560) / 2.
  680 is for a 1920px-wide output — adjust for your resolution.
-->
<windowRules>
  <windowRule identifier="*aether*" serverDecoration="no" skipTaskbar="yes"
              skipWindowSwitcher="yes" fixedPosition="yes">
    <action name="ToggleAlwaysOnTop"/>
    <action name="MoveTo" x="680" y="0"/>
  </windowRule>
</windowRules>
